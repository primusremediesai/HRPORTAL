  "dependencies": {
    "argon2": "^0.45.1",
    "connect-mongo": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.6.2",
    "express-session": "^1.19.0",
    "googleapis": "^187.0.0",
    "helmet": "^8.3.0",
    "mongodb-memory-server": "^11.2.0",
    "mongoose": "^9.9.4",
    "multer": "^2.4.0",
    "nodemailer": "^10.2.0"
  },
  "devDependencies": {
