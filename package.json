    "db:reset": "node scripts/dbTools.js reset",
    "storage:setup": "node scripts/setupGoogleDrive.js",
    "test": "echo \"Error: no test specified\" && exit 0"
  },
  "keywords": [
    "hr",
    "management",
    "portal"
  ],
  "author": "",
  "license": "ISC",
