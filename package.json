{
  "name": "primus-hr-portal",
  "version": "1.0.0",
  "description": "Primus HR Management Portal with Persistent DB, Auth, and 5 TB Google Drive Storage",
  "main": "run.js",
  "scripts": {
    "start": "node run.js",
    "dev": "node --watch run.js",
    "db:seed": "node scripts/dbTools.js seed",
