# Server Configuration
PORT=3000
NODE_ENV=development
SESSION_SECRET=primus_hr_portal_super_secret_session_key_2026

# Database Configuration (Auto-set by run.js to persistent local folder ./data/db if not overridden)
# MONGODB_URI=mongodb://127.0.0.1:27017/hrportal

# Google Drive 5 TB Cloud Storage Integration (Google AI Pro / Google One)
# Option A: OAuth 2.0 (Run: npm run storage:setup)
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:3000/api/files/oauth2callback
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_ROOT_FOLDER_NAME=HRPortal_App_Storage

# Option B: Google Cloud Service Account
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json


# Fallback local upload directory (used if Google Drive is not yet linked)
LOCAL_UPLOAD_DIR=./uploads

# Base URL for temporary approval links (sent in approval emails)
APP_BASE_URL=http://localhost:3000

# Default HR / Finance Approver Emails (used when routing approvals)
HR_EMAIL=hr@primus.local
FINANCE_EMAIL=finance@primus.local

# Gmail / SMTP Email Configuration (If not configured, emails are written to ./data/outbox/)
# Option A: Gmail Direct (Recommended for Gmail / Google Workspace with App Password)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Option B: Standard SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Primus HR Portal" <no-reply@primus.local>

